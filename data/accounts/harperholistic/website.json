  "draft": {
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>HarperHolistic — Boundaries are my Love Language</title>\n<meta name=\"description\" content=\"Healing inspiration card decks and membership. Speak your truth and protect your peace with the Boundaries are my Love Language deck, Cancer Care Cards and Momma's Earth Magick.\">\n<style>\n  :root{\n    --ink:#2a2640; --soft:#6b6484; --cream:#faf7f2; --rose:#c98a9a;\n    --sage:#8ba888; --gold:#d8b26a; --card:#ffffff; --line:#ece6dd;\n  }\n  *{box-sizing:border-box;margin:0;padding:0}\n  body{font-family:'Georgia',serif;color:var(--ink);background:var(--cream);line-height:1.65}\n  h1,h2,h3,.nav-logo{font-family:'Georgia',serif;letter-spacing:.3px}\n  a{color:inherit;text-decoration:none}\n  .wrap{max-width:1080px;margin:0 auto;padding:0 22px}\n  .btn{display:inline-block;background:var(--rose);color:#fff;padding:15px 34px;border-radius:40px;font-size:1rem;letter-spacing:.5px;transition:.25s;border:none;cursor:pointer}\n  .btn:hover{background:#b5788a;transform:translateY(-2px)}\n  .btn.ghost{background:transparent;border:1.5px solid var(--rose);color:var(--rose)}\n  .btn.ghost:hover{background:var(--rose);color:#fff}\n\n  nav{position:sticky;top:0;z-index:20;background:rgba(250,247,242,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}\n  nav .wrap{display:flex;align-items:center;justify-content:space-between;padding-top:16px;padding-bottom:16px}\n  .nav-logo{font-size:1.35rem;color:var(--ink)}\n  .nav-logo span{color:var(--rose)}\n  .nav-links a{margin-left:26px;color:var(--soft);font-size:.95rem}\n  .nav-links a:hover{color:var(--ink)}\n  @media(max-width:640px){.nav-links{display:none}}\n\n  header.hero{background:linear-gradient(160deg,#efe7f0 0%,#faf7f2 55%,#eef2ea 100%);padding:90px 0 80px;text-align:center}\n  .hero .eyebrow{color:var(--rose);text-transform:uppercase;letter-spacing:3px;font-size:.8rem;margin-bottom:18px}\n  .hero h1{font-size:2.8rem;line-height:1.2;max-width:760px;margin:0 auto 22px}\n  .hero p.lead{font-size:1.2rem;color:var(--soft);max-width:580px;margin:0 auto 34px}\n  .hero .btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}\n  @media(max-width:640px){.hero h1{font-size:2rem}}\n\n  section{padding:72px 0}\n  .section-head{text-align:center;max-width:620px;margin:0 auto 48px}\n  .section-head .eyebrow{color:var(--sage);text-transform:uppercase;letter-spacing:3px;font-size:.78rem;margin-bottom:12px}\n  .section-head h2{font-size:2.1rem;margin-bottom:14px}\n  .section-head p{color:var(--soft);font-size:1.05rem}\n\n  /* Gillian note */\n  .note{background:#fff;border:1px solid var(--line);border-radius:20px;padding:44px;max-width:760px;margin:0 auto;box-shadow:0 10px 40px rgba(42,38,64,.05);position:relative}\n  .note:before{content:'\\201C';position:absolute;top:-10px;left:28px;font-size:5rem;color:var(--rose);opacity:.35;font-family:Georgia}\n  .note p{font-size:1.15rem;color:var(--ink);font-style:italic;margin-bottom:18px}\n  .note .sign{color:var(--rose);font-size:1.05rem}\n\n  /* Decks */\n  .decks{background:linear-gradient(180deg,#faf7f2,#f3eee6)}\n  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}\n  @media(max-width:860px){.grid{grid-template-columns:1fr}}\n  .deck{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:32px;transition:.25s}\n  .deck:hover{transform:translateY(-6px);box-shadow:0 16px 40px rgba(42,38,64,.08)}\n  .deck .tag{display:inline-block;font-size:.72rem;letter-spacing:1.5px;text-transform:uppercase;padding:5px 12px;border-radius:30px;margin-bottom:16px}\n  .deck.t1 .tag{background:#f6e4e9;color:#b5788a}\n  .deck.t2 .tag{background:#e8f0e6;color:#5f7a5c}\n  .deck.t3 .tag{background:#f5edd9;color:#a9842f}\n  .deck h3{font-size:1.4rem;margin-bottom:10px}\n  .deck p{color:var(--soft);font-size:.98rem}\n\n  /* Membership perks */\n  .perks .grid{grid-template-columns:repeat(3,1fr)}\n  @media(max-width:860px){.perks .grid{grid-template-columns:1fr}}\n  .perk{text-align:center;padding:20px}\n  .perk .ic{font-size:2rem;margin-bottom:14px}\n  .perk h3{font-size:1.15rem;margin-bottom:8px}\n  .perk p{color:var(--soft);font-size:.95rem}\n\n  /* Reflections */\n  .reflections{background:linear-gradient(160deg,#eef2ea,#faf7f2)}\n  .refl-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px;max-width:860px;margin:0 auto}\n  @media(max-width:640px){.refl-grid{grid-template-columns:1fr}}\n  .refl{background:#fff;border-radius:16px;padding:28px;border:1px solid var(--line)}\n  .refl p{font-style:italic;color:var(--ink);margin-bottom:14px}\n  .refl .who{color:var(--sage);font-size:.9rem;letter-spacing:.5px}\n\n  /* CTA */\n  .cta{background:var(--ink);color:#fff;text-align:center}\n  .cta h2{font-size:2.2rem;margin-bottom:16px;color:#fff}\n  .cta p{color:#c7c1dc;max-width:520px;margin:0 auto 30px;font-size:1.1rem}\n\n  footer{background:#201d33;color:#9b95b5;padding:40px 0;text-align:center;font-size:.9rem}\n  footer .nav-logo{color:#fff;font-size:1.2rem;display:block;margin-bottom:10px}\n  footer a{color:var(--rose)}\n</style>\n</head>\n<body>\n\n<nav>\n  <div class=\"wrap\">\n    <div class=\"nav-logo\">Harper<span>Holistic</span></div>\n    <div class=\"nav-links\">\n      <a href=\"#decks\">The Decks</a>\n      <a href=\"#membership\">Membership</a>\n      <a href=\"#reflections\">Reflections</a>\n      <a href=\"#join\">Join</a>\n    </div>\n  </div>\n</nav>\n\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <p class=\"eyebrow\">Healing card deck membership</p>\n    <h1>Boundaries are my Love Language</h1>\n    <p class=\"lead\">Speak your truth and protect your peace — with healing inspiration cards, affirmations and rituals for your journey.</p>\n    <div class=\"btns\">\n      <a href=\"#join\" class=\"btn\">Start your membership</a>\n      <a href=\"#decks\" class=\"btn ghost\">Explore the decks</a>\n    </div>\n  </div>\n</header>\n\n<section>\n  <div class=\"wrap\">\n    <div class=\"note\">\n      <p>I made these cards for the moments when you need gentle permission — to rest, to say no, to hold your own peace sacred. Every deck is a companion for the hard, beautiful work of healing. I'm so glad you're here.</p>\n      <div class=\"sign\">— Gillian, founder of HarperHolistic</div>\n    </div>\n  </div>\n</section>\n\n<section class=\"decks\" id=\"decks\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">Choose your companion</p>\n      <h2>The Card Decks</h2>\n      <p>Each deck is a different doorway into healing. Pick the one that meets you where you are.</p>\n    </div>\n    <div class=\"grid\">\n      <div class=\"deck t1\">\n        <span class=\"tag\">For boundaries</span>\n        <h3>Boundaries are my Love Language</h3>\n        <p>Affirmations and prompts to help you speak your truth, honour your limits, and protect your peace without guilt.</p>\n      </div>\n      <div class=\"deck t2\">\n        <span class=\"tag\">For hard seasons</span>\n        <h3>Cancer Care Cards</h3>\n        <p>Tender support for anyone facing cancer — or walking beside a loved one through it. Comfort, courage and gentle words when they matter most.</p>\n      </div>\n      <div class=\"deck t3\">\n        <span class=\"tag\">For grounding</span>\n        <h3>Momma's Earth Magick</h3>\n        <p>Rituals, intuition and earth-rooted affirmations to reconnect you with nature, nurture and your own quiet magic.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"perks\" id=\"membership\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">What's inside</p>\n      <h2>Your membership</h2>\n      <p>More than a deck — an ongoing practice that grows with you.</p>\n    </div>\n    <div class=\"grid\">\n      <div class=\"perk\"><div class=\"ic\">📖</div><h3>Guidebook, affirmations &amp; journal</h3><p>Everything you need to work with your cards intentionally, day by day.</p></div>\n      <div class=\"perk\"><div class=\"ic\">🌙</div><h3>Weekly reflections</h3><p>A fresh prompt each week to keep your practice alive and moving forward.</p></div>\n      <div class=\"perk\"><div class=\"ic\">💌</div><h3>Personal notes from Gillian</h3><p>Warm, honest words from the heart of HarperHolistic — like a friend checking in.</p></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"reflections\" id=\"reflections\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <p class=\"eyebrow\">From the community</p>\n      <h2>Reflections</h2>\n      <p>Words from people walking their own healing journey with HarperHolistic.</p>\n    </div>\n    <div class=\"refl-grid\">\n      <div class=\"refl\"><p>Pulling a card each morning has become my gentlest boundary. It reminds me my peace is worth protecting.</p><div class=\"who\">— A HarperHolistic member</div></div>\n      <div class=\"refl\"><p>The Cancer Care Cards gave me words when I had none. I sent them to my mum and we read them together.</p><div class=\"who\">— A HarperHolistic member</div></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"cta\" id=\"join\">\n  <div class=\"wrap\">\n    <h2>Protect your peace, starting today</h2>\n    <p>Join the HarperHolistic membership and let your cards guide the way.</p>\n    <a href=\"mailto:hello@harperholistic.xyz\" class=\"btn\">Start your membership</a>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap\">\n    <span class=\"nav-logo\">Harper<span style=\"color:var(--rose)\">Holistic</span></span>\n    Boundaries are my Love Language — speak your truth and protect your peace.<br>\n    <a href=\"mailto:hello@harperholistic.xyz\">hello@harperholistic.xyz</a>\n  </div>\n</footer>\n\n</body>\n</html>",

  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Larpify — Prop-Grade Simulator Apps for Content Creators</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  :root {\n    --bg: #0b0b12;\n    --panel: #14141f;\n    --accent: #7c5cff;\n    --accent2: #ff5ca8;\n    --text: #f3f3f8;\n    --muted: #a0a0b8;\n  }\n  html { scroll-behavior: smooth; }\n  body {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n    background: var(--bg);\n    color: var(--text);\n    line-height: 1.6;\n  }\n  a { color: inherit; text-decoration: none; }\n  .wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px; }\n\n  /* NAV */\n  nav {\n    position: sticky; top: 0; z-index: 50;\n    backdrop-filter: blur(12px);\n    background: rgba(11,11,18,0.75);\n    border-bottom: 1px solid rgba(255,255,255,0.06);\n  }\n  nav .wrap { display: flex; align-items: center; justify-content: space-between; height: 68px; }\n  .logo { font-weight: 800; font-size: 1.35rem; letter-spacing: -0.02em; }\n  .logo span { background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; background-clip: text; color: transparent; }\n  .nav-links { display: flex; gap: 28px; }\n  .nav-links a { color: var(--muted); font-size: 0.95rem; font-weight: 500; transition: color .2s; }\n  .nav-links a:hover { color: var(--text); }\n  .btn {\n    display: inline-block;\n    background: linear-gradient(90deg, var(--accent), var(--accent2));\n    color: #fff; font-weight: 700;\n    padding: 13px 26px; border-radius: 999px;\n    transition: transform .15s, box-shadow .15s;\n    box-shadow: 0 8px 30px rgba(124,92,255,0.35);\n  }\n  .btn:hover { transform: translateY(-2px); box-shadow: 0 12px 38px rgba(124,92,255,0.5); }\n  @media (max-width: 640px){ .nav-links { display: none; } }\n\n  /* HERO */\n  .hero { position: relative; overflow: hidden; padding: 110px 0 120px; }\n  .hero::before {\n    content: ''; position: absolute; top: -200px; right: -150px;\n    width: 600px; height: 600px; border-radius: 50%;\n    background: radial-gradient(circle, rgba(124,92,255,0.35), transparent 70%);\n    filter: blur(40px);\n  }\n  .hero::after {\n    content: ''; position: absolute; bottom: -250px; left: -150px;\n    width: 500px; height: 500px; border-radius: 50%;\n    background: radial-gradient(circle, rgba(255,92,168,0.25), transparent 70%);\n    filter: blur(40px);\n  }\n  .hero .wrap { position: relative; z-index: 2; max-width: 820px; }\n  .pill {\n    display: inline-block; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.04em;\n    text-transform: uppercase; color: var(--accent);\n    border: 1px solid rgba(124,92,255,0.4); border-radius: 999px;\n    padding: 6px 16px; margin-bottom: 26px;\n  }\n  .hero h1 { font-size: clamp(2.4rem, 6vw, 4rem); line-height: 1.05; letter-spacing: -0.03em; font-weight: 800; }\n  .hero h1 em { font-style: normal; background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; background-clip: text; color: transparent; }\n  .hero p { font-size: 1.2rem; color: var(--muted); margin: 26px 0 38px; max-width: 620px; }\n  .hero-cta { display: flex; gap: 16px; flex-wrap: wrap; }\n  .btn-ghost { border: 1px solid rgba(255,255,255,0.18); padding: 13px 26px; border-radius: 999px; font-weight: 600; transition: border-color .2s; }\n  .btn-ghost:hover { border-color: var(--accent); }\n\n  /* SECTION */\n  section { padding: 90px 0; }\n  .section-head { text-align: center; max-width: 620px; margin: 0 auto 56px; }\n  .section-head h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); letter-spacing: -0.02em; font-weight: 800; }\n  .section-head p { color: var(--muted); margin-top: 14px; font-size: 1.05rem; }\n\n  /* SERVICES GRID */\n  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 22px; }\n  .card {\n    background: var(--panel); border: 1px solid rgba(255,255,255,0.06);\n    border-radius: 18px; padding: 30px;\n    transition: transform .2s, border-color .2s;\n  }\n  .card:hover { transform: translateY(-4px); border-color: rgba(124,92,255,0.5); }\n  .card .ico { font-size: 1.8rem; margin-bottom: 16px; display: block; }\n  .card h3 { font-size: 1.2rem; margin-bottom: 10px; font-weight: 700; }\n  .card p { color: var(--muted); font-size: 0.97rem; }\n\n  /* WHY */\n  .why { background: linear-gradient(180deg, transparent, rgba(124,92,255,0.05)); }\n  .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px,1fr)); gap: 40px; }\n  .why-item { display: flex; gap: 16px; align-items: flex-start; }\n  .why-item .num { font-size: 1.4rem; font-weight: 800; background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; background-clip: text; color: transparent; min-width: 42px; }\n  .why-item h4 { font-size: 1.1rem; margin-bottom: 6px; }\n  .why-item p { color: var(--muted); font-size: 0.96rem; }\n\n  /* CTA BAND */\n  .cta-band { text-align: center; }\n  .cta-box {\n    background: linear-gradient(135deg, rgba(124,92,255,0.18), rgba(255,92,168,0.14));\n    border: 1px solid rgba(124,92,255,0.3);\n    border-radius: 26px; padding: 64px 32px;\n  }\n  .cta-box h2 { font-size: clamp(1.8rem,4vw,2.6rem); font-weight: 800; letter-spacing: -0.02em; }\n  .cta-box p { color: var(--muted); margin: 16px auto 32px; max-width: 480px; }\n\n  /* FOOTER */\n  footer { border-top: 1px solid rgba(255,255,255,0.06); padding: 48px 0; color: var(--muted); }\n  footer .wrap { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }\n  footer .logo { font-size: 1.1rem; }\n</style>\n</head>\n<body>\n\n<nav>\n  <div class=\"wrap\">\n    <div class=\"logo\">Larp<span>ify</span></div>\n    <div class=\"nav-links\">\n      <a href=\"#services\">Apps</a>\n      <a href=\"#why\">Why Larpify</a>\n      <a href=\"#start\">Get Started</a>\n    </div>\n    <a href=\"#start\" class=\"btn\">Start Creating</a>\n  </div>\n</nav>\n\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <span class=\"pill\">Simulator apps for content creators</span>\n    <h1>Prop-grade simulator apps for <em>skits, tutorials &amp; reaction videos</em>.</h1>\n    <p>Larpify gives creators believable on-screen props that look the part on camera — fully customisable, full-screen, and ready to shoot. No awkward mock-ups, no breaking the scene.</p>\n    <div class=\"hero-cta\">\n      <a href=\"#start\" class=\"btn\">Start Creating</a>\n      <a href=\"#services\" class=\"btn-ghost\">See the apps</a>\n    </div>\n  </div>\n</header>\n\n<section id=\"services\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <h2>Simulator apps built for the shot</h2>\n      <p>Everything you need to make a scene land — customisable, convincing and full-screen.</p>\n    </div>\n    <div class=\"grid\">\n      <div class=\"card\">\n        <span class=\"ico\">🎬</span>\n        <h3>Apps for Skits</h3>\n        <p>Drop a believable prop into any bit. Perfect for comedy, storytimes and scripted scenes that need the detail to sell the joke.</p>\n      </div>\n      <div class=\"card\">\n        <span class=\"ico\">📚</span>\n        <h3>Apps for Tutorials</h3>\n        <p>Walk your audience through a clean, controlled screen every time — no personal info, no bloopers, just the demo you planned.</p>\n      </div>\n      <div class=\"card\">\n        <span class=\"ico\">😮</span>\n        <h3>Apps for Reaction Videos</h3>\n        <p>Set the scene exactly how you want it so the reaction hits. Reliable props that keep the camera rolling.</p>\n      </div>\n      <div class=\"card\">\n        <span class=\"ico\">✏️</span>\n        <h3>Custom Names &amp; Numbers</h3>\n        <p>Tailor names and numbers on screen so every prop fits your story and your characters.</p>\n      </div>\n      <div class=\"card\">\n        <span class=\"ico\">🖥️</span>\n        <h3>Customizable Screens</h3>\n        <p>Dial in the details until the screen looks right for your scene — your content, your way.</p>\n      </div>\n      <div class=\"card\">\n        <span class=\"ico\">📲</span>\n        <h3>Home Screen Install</h3>\n        <p>Install to your home screen for full-screen shooting — props that fill the frame with nothing getting in the way.</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"why\" class=\"why\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <h2>Why creators pick Larpify</h2>\n      <p>Made for people who shoot for a living — practical tools that get out of your way.</p>\n    </div>\n    <div class=\"why-grid\">\n      <div class=\"why-item\">\n        <div class=\"num\">01</div>\n        <div><h4>Prop-grade realism</h4><p>Screens convincing enough to carry the scene, so your audience stays in the story.</p></div>\n      </div>\n      <div class=\"why-item\">\n        <div class=\"num\">02</div>\n        <div><h4>Fully customisable</h4><p>Names, numbers and screens you can shape to fit any skit, tutorial or reaction.</p></div>\n      </div>\n      <div class=\"why-item\">\n        <div class=\"num\">03</div>\n        <div><h4>Full-screen ready</h4><p>Home screen install means edge-to-edge footage with no distractions in frame.</p></div>\n      </div>\n      <div class=\"why-item\">\n        <div class=\"num\">04</div>\n        <div><h4>Built for creators</h4><p>Designed around how you actually shoot — fast to set up, reliable on camera.</p></div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"start\" class=\"cta-band\">\n  <div class=\"wrap\">\n    <div class=\"cta-box\">\n      <h2>Ready to level up your next shoot?</h2>\n      <p>Bring prop-grade simulator apps to your skits, tutorials and reaction videos. Let's make your next scene look the part.</p>\n      <a href=\"https://larpifyy.com/\" class=\"btn\">Get Started with Larpify</a>\n    </div>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap\">\n    <div class=\"logo\">Larp<span>ify</span></div>\n    <div>© 2026 Larpify · Prop-grade simulator apps for content creators</div>\n  </div>\n</footer>\n\n</body>\n</html>",

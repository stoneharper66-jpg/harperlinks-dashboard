# ---- AI brain -------------------------------------------------------------
# Without this the app runs in DEMO mode (keyword brain, no real writing).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Publishing via GoHighLevel (legacy fallback for the founder account)
# Customer accounts get their GHL credentials through the dashboard:
# Customer Accounts -> GoHighLevel button. These env vars only apply to the
# founder ("main") account, kept so the original setup keeps working.
#
# ---- Original notes -------------------------------------------
# Lets posts actually reach Instagram / Facebook / TikTok / LinkedIn / YouTube.
# GHL holds the platform approvals, so no Meta/TikTok app review needed.
#   1. Connect your socials in GHL -> Marketing -> Social Planner
#   2. GHL -> Settings -> Private Integrations -> create a token with scopes
#      socialplanner/post.write and socialplanner/account.readonly
#   3. Location id is in your GHL dashboard URL:
#      app.gohighlevel.com/v2/location/<THIS>/dashboard
# Leave blank and publishing stays in honest preview mode.
GHL_TOKEN=
GHL_LOCATION_ID=

# ---- Server ---------------------------------------------------------------
PORT=4700
